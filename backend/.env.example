# Yandex Cloud AI Studio
YANDEX_API_KEY=replace_me
YANDEX_FOLDER_ID=your_yandex_cloud_folder_id
YANDEX_MODEL=yandexgpt-5.1

# GigaChat API (Authorization Key from the Sber developer cabinet)
GIGACHAT_AUTH_KEY=replace_me
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
# Optional: configure this if your host requires the MinCifry CA bundle
# NODE_EXTRA_CA_CERTS=/absolute/path/to/russian-trusted-root-ca.pem

PORT=8787
RATE_LIMIT_MAX=30
